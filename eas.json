{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "medium"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "android-test": {
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6818896969"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6818896969"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
